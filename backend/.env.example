# Choose your provider: gemini | openai | claude
LLM_PROVIDER=gemini

# Optional: override the default model for the chosen provider
# LLM_MODEL=gemini-2.0-flash-lite

# Add the key for your chosen provider — only the one you're using needs to be set
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Email sharing (AWS SES SMTP) ────────────────────────────────────────────
# Required for POST /courses/{id}/share.
# These are SES SMTP credentials (generated in the SES console under
# "SMTP settings → Create SMTP credentials"). They are NOT regular IAM keys.
#
# Port defaults to 2587 (SES's non-standard submission port). 2587 works on
# Cloud Run, AWS, and locally. Override to 587 only on networks that block
# non-standard outbound ports.
SES_FROM=CourseBuilder <noreply@yourdomain.com>
AWS_SMTP_USERNAME=your_ses_smtp_username
AWS_SMTP_PASSWORD=your_ses_smtp_password
AWS_SES_SMTP_HOST=email-smtp.us-west-2.amazonaws.com
AWS_SES_SMTP_PORT=2587
